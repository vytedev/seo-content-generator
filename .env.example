# MM03-01 local setup

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mm0301

# Operator login
# Recommended: run `npm run auth:setup`. Each installation should create its
# own operator password and session secret; never copy another person's .env.
OPERATOR_EMAIL=replace-with-operator-email
# Generate manually with `npm run auth:hash-password`, or use auth:setup above.
OPERATOR_PASSWORD_HASH=replace-with-generated-scrypt-hash
# Use at least 32 random characters. auth:setup generates this automatically.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=12

# Local testing only. Keep false for normal runs.
LOCAL_ALLOW_UNVERIFIED_LINK_BYPASS=false

# AI provider — configure OpenRouter or Hugging Face, not both.
OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_MODEL=replace-with-pinned-model-id
# HF_TOKEN=replace-with-hugging-face-token
# HF_MODEL=replace-with-pinned-model-id

# Google OAuth for Docs export and optional Search Console enrichment.
# Each installation needs an authorised Google Cloud OAuth client. Enable the
# Google Docs and Drive APIs; enable Search Console when GSC enrichment is used.
# Register the redirect URI below exactly, then connect the intended Google
# account inside the app. Never copy another operator's stored Google session.
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3110/api/integrations/google/callback
# Generate a different key per installation with: openssl rand -base64 32
# Changing this key later makes previously stored Google tokens unreadable and
# requires reconnecting Google.
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Step 1.2 — internal-link discovery
# Point at the English sitemap: it matches the UK-English launch scope and stays
# within bounds (the full multi-locale index is ~50 MB across locales).
INTERNAL_LINK_SITEMAP_URL=https://www.mobelaris.com/en/sitemap.xml
INTERNAL_LINK_SITE_ORIGIN=https://www.mobelaris.com
INTERNAL_LINK_ALLOWED_ORIGINS=https://www.mobelaris.com,https://searchconsole.googleapis.com
# The English sitemap is ~4.1 MB; the default 1 MB bound rejects it.
INTERNAL_LINK_MAX_RESPONSE_BYTES=5242880
INTERNAL_LINK_MAX_SITEMAP_URLS=5000
# Use the exact Search Console property. Remove to use sitemap only (GSC
# enrichment also requires the operator Google OAuth connection to be linked).
# GSC_SITE_URL=https://www.mobelaris.com/

# Step 1.7 — public storefront fact verification
FACT_VERIFIER_ALLOWED_ORIGINS=https://www.mobelaris.com

# Optional auxiliary SERP composition probe. It is warning-only and disabled by
# default. When explicitly enabled, endpoint and token are required and malformed
# configuration fails startup.
SERP_PROBE_ENABLED=false
# SERP_PROBE_ENDPOINT=https://example.invalid/serp
# SERP_PROBE_TOKEN=replace-with-provider-token
# SERP_PROBE_PROVIDER=configured-serp
# SERP_PROBE_TIMEOUT_MS=3000
# SERP_PROBE_MAX_RESPONSE_BYTES=32768

# Optional Step 1.7 limits. Defaults are used when omitted.
# FACT_VERIFIER_TIMEOUT_MS=8000
# FACT_VERIFIER_MAX_RESPONSE_BYTES=524288
# FACT_VERIFIER_MAX_CANDIDATES=30
# FACT_VERIFIER_CONCURRENCY=4
# FACT_VERIFIER_RETRIES=1
