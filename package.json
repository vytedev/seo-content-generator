{
  "name": "mm03-01-seo-content-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web,build \"tsx watch --env-file-if-exists=.env src/server/index.ts\" \"vite --clearScreen false --logLevel error\" \"vite build --watch --logLevel error\"",
    "dev:host": "concurrently -k -n api,web \"tsx watch --env-file-if-exists=.env src/server/index.ts\" \"vite --clearScreen false --logLevel error\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:client": "vite --clearScreen false --logLevel error",
    "dev:client:build": "vite build --watch --logLevel error",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test",
    "db:generate": "drizzle-kit generate",
    "db:studio": "tsx --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs studio --host 127.0.0.1 --port 4983",
    "db:seed:references": "tsx --env-file-if-exists=.env scripts/seed-reference-slots.ts",
    "db:import:local-baseline": "tsx --env-file-if-exists=.env scripts/import-local-baseline.ts",
    "auth:hash-password": "tsx scripts/hash-operator-password.ts",
    "auth:setup": "tsx scripts/setup-operator-auth.ts"
  },
  "dependencies": {
    "@types/mdast": "^4.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "lucide-react": "^1.32.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.21",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "shadcn": "^4.18.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.6",
    "vitest": "^3.1.3"
  }
}
